<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title : 'LoanLens — Loan Default Prediction & Risk Intelligence' %></title>
<meta name="description" content="Interactive machine learning platform for loan default risk prediction, model comparison, and exploratory data analysis.">
<meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'LoanLens — Loan Default Prediction & Risk Intelligence' %>">
<meta property="og:description" content="Interactive machine learning platform for loan default risk prediction, model comparison, and exploratory data analysis.">
<link rel="stylesheet" href="/static/css/app.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
  (function () {
    var saved = localStorage.getItem('loanlens-theme') || 'light';
    document.documentElement.setAttribute('data-theme', saved);
  })();
</script>
</head>
<body>

<a class="skip-link" href="#main-content">Skip to main content</a>

<!-- Mobile Drawer Backdrop Overlay -->
<div class="drawer-backdrop" id="drawerBackdrop" aria-hidden="true"></div>

<div class="app-shell">

  <!-- Unified Navigation Sidebar (Desktop Fixed + Mobile Slide-In Drawer) -->
  <aside class="app-sidebar" id="appSidebar" aria-label="Primary Navigation">
    <div class="sb-brand">
      <a href="/overview" style="display:flex; align-items:center; gap:12px; text-decoration:none;">
        <div class="brand-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <div class="brand-text">
          <span class="brand-name">LoanLens</span>
          <span class="brand-badge">ML Risk Platform</span>
        </div>
      </a>
      <button type="button" class="drawer-close-btn" id="drawerCloseBtn" aria-label="Close navigation menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div class="sb-nav-container">
      <% if (typeof nav !== 'undefined') { %>
        <% for (const group of nav) { %>
          <div class="nav-section">
            <div class="nav-section-title"><%= group.group %></div>
            <ul class="nav-list">
              <% for (const item of group.items) { %>
                <li>
                  <a class="nav-link <%= currentPath === item.route || (item.route === '/overview' && currentPath === '/') || (item.route === '/assess' && currentPath === '/predict') ? 'active' : '' %>" 
                     href="<%= item.route %>"
                     <% if (currentPath === item.route) { %>aria-current="page"<% } %>>
                    <%- icon(item.icon) %>
                    <span><%= item.label %></span>
                  </a>
                </li>
              <% } %>
            </ul>
          </div>
        <% } %>
      <% } %>
    </div>

    <div class="sb-footer">
      <div class="system-status-chip">
        <span class="status-dot" aria-hidden="true"></span>
        <span style="font-weight:600;">ML Engine: Ready</span>
      </div>
      <div style="font-size:11px; color:var(--muted); text-align:center;">
        v1.0 &middot; Logistic Regression
      </div>
    </div>
  </aside>

  <!-- Main View Container -->
  <div class="app-main">
    
    <!-- Topbar Header -->
    <header class="app-topbar">
      <div class="topbar-left">
        <button type="button" class="menu-toggle-btn" id="mobileMenuBtn" aria-label="Open navigation menu" aria-expanded="false" aria-controls="appSidebar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="topbar-crumb">
          <%- typeof crumb !== 'undefined' ? crumb : '<b>Workspace</b> / Overview' %>
        </div>
      </div>

      <div class="topbar-right">
        <button type="button" class="theme-toggle-btn" id="themeToggleBtn" aria-label="Toggle visual theme">
          <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <span class="theme-text">Theme</span>
        </button>
      </div>
    </header>

    <!-- Main Content Injection Target -->
    <main id="main-content" class="content-wrapper">
