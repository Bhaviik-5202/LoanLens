    <span class="btn btn-secondary" style="font-size:13px; font-weight:500; padding:6px 14px; cursor:default;">Node.js</span>
    <span class="btn btn-secondary" style="font-size:13px; font-weight:500; padding:6px 14px; cursor:default;">Express.js</span>
    <span class="btn btn-secondary" style="font-size:13px; font-weight:500; padding:6px 14px; cursor:default;">EJS (SSR)</span>
    <span class="btn btn-secondary" style="font-size:13px; font-weight:500; padding:6px 14px; cursor:default;">Modern CSS3</span>
