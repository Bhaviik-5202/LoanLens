<%- include('../partials/header', { title: 'New Risk Assessment — LoanLens', crumb: '<b>Workspace</b> / New Assessment', currentPath: '/assess' }) %>

<div style="max-width: 1040px; margin: 0 auto; padding-bottom: 60px;">

  <!-- Page Header -->
  <div style="margin-bottom: 28px; display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px;">
    <div>
      <h1 style="font-size:26px; font-weight:700; margin:0 0 6px 0; color:var(--text);">Borrower Risk Assessment</h1>
      <p style="color:var(--muted); margin:0; font-size:14px;">
        Submit borrower attributes to evaluate default probability, credit risk signals, and explainable factors.
      </p>
    </div>

    <!-- Quick Sample Presets (Exact 16 features, No Name) -->
    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
      <span style="font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:0.04em;">Load Sample:</span>
      <button type="button" class="btn btn-secondary" data-preset="prime" style="padding:6px 12px; font-size:12px;">
        Prime (Low Risk)
      </button>
      <button type="button" class="btn btn-secondary" data-preset="moderate" style="padding:6px 12px; font-size:12px;">
        Moderate Risk
      </button>
      <button type="button" class="btn btn-secondary" data-preset="subprime" style="padding:6px 12px; font-size:12px;">
        Subprime (High Risk)
      </button>
    </div>
  </div>

  <!-- Honest Model Selector Section -->
  <div class="card card-padded" style="margin-bottom:28px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
      <div>
        <h2 style="font-size:15px; font-weight:700; margin:0 0 2px;">Machine Learning Inference Architecture</h2>
        <p style="font-size:12px; color:var(--muted); margin:0;">
          Logistic Regression is designated as the active production scoring model. Other models are benchmark baselines.
        </p>
      </div>
      <a href="/model/comparison" style="font-size:12px; color:var(--brand); font-weight:600; text-decoration:none;">
        Compare All Models &rarr;
      </a>
    </div>

    <div class="model-selector-grid">
      <!-- 1. Active Production Model -->
      <div class="model-option-card selected" data-model="logistic_regression">
        <div class="model-option-head">
          <span class="model-name">Logistic Regression</span>
          <span class="model-status-tag tag-active">&#10003; Active Model</span>
        </div>
        <div class="model-meta-info">
          L2-regularized balanced inference engine. 0.7532 ROC-AUC &middot; 69.95% recall.
        </div>
      </div>

      <!-- 2. KNN Benchmark -->
      <div class="model-option-card" data-model="knn" title="Click to view benchmark information">
        <div class="model-option-head">
          <span class="model-name">K-Nearest Neighbors</span>
          <span class="model-status-tag tag-benchmark">Benchmark Only</span>
        </div>
        <div class="model-meta-info">
          Distance-weighted (k=25). Evaluated for local metric baseline comparison.
        </div>
      </div>

      <!-- 3. Naive Bayes Benchmark -->
      <div class="model-option-card" data-model="naive_bayes" title="Click to view benchmark information">
        <div class="model-option-head">
          <span class="model-name">Gaussian Naive Bayes</span>
          <span class="model-status-tag tag-benchmark">Benchmark Only</span>
        </div>
        <div class="model-meta-info">
          Probabilistic independence baseline with variance smoothing (1e-5).
        </div>
      </div>

      <!-- 4. Decision Tree Benchmark -->
      <div class="model-option-card" data-model="decision_tree" title="Click to view benchmark information">
        <div class="model-option-head">
          <span class="model-name">Decision Tree</span>
          <span class="model-status-tag tag-benchmark">Benchmark Only</span>
        </div>
        <div class="model-meta-info">
          Entropy partitioning (max_depth=6). Structural decision comparison.
        </div>
      </div>
    </div>

    <!-- Benchmark Model Information Banner (hidden by default) -->
    <div id="benchmarkNotice" style="display:none; padding:12px 16px; background:var(--panel-2); border-left:3px solid var(--brand); border-radius:6px; font-size:12px; color:var(--text-secondary);">
      <span id="benchmarkNoticeText"></span>
      <a href="/model/comparison" style="margin-left:8px; color:var(--brand); font-weight:600;">View in Comparison Matrix &rarr;</a>
    </div>
  </div>

  <!-- Main Assessment Form Card -->
  <div class="card card-padded" id="formCard">
    <form id="assessmentForm" onsubmit="return false;">

      <!-- SECTION 1: Borrower Information -->
      <div style="margin-bottom:32px;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <span style="width:24px; height:24px; border-radius:50%; background:var(--brand-soft); color:var(--brand); font-size:12px; font-weight:700; display:flex; align-items:center; justify-content:center;">1</span>
          <h2 style="font-size:16px; font-weight:700; margin:0;">Borrower Profile</h2>
        </div>
        <p style="font-size:12px; color:var(--muted); margin:0 0 16px 32px;">Demographic background and household attributes.</p>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:16px; padding-left:32px;">
          <div class="form-group">
            <label class="form-label" for="Age">Age (Years) *</label>
            <input type="number" class="form-input" id="Age" name="Age" min="18" max="100" value="42" required>
            <span class="form-hint">Accepted range: 18 – 100</span>
          </div>

          <div class="form-group">
            <label class="form-label" for="Education">Education Level *</label>
            <select class="form-select" id="Education" name="Education" required>
              <option value="High School">High School</option>
              <option value="Bachelor's">Bachelor's</option>
              <option value="Master's" selected>Master's</option>
              <option value="PhD">PhD</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="MaritalStatus">Marital Status *</label>
            <select class="form-select" id="MaritalStatus" name="MaritalStatus" required>
              <option value="Single">Single</option>
              <option value="Married" selected>Married</option>
              <option value="Divorced">Divorced</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="HasDependents">Has Dependents *</label>
            <select class="form-select" id="HasDependents" name="HasDependents" required>
              <option value="No" selected>No</option>
              <option value="Yes">Yes</option>
            </select>
          </div>
        </div>
      </div>

      <!-- SECTION 2: Financial Profile -->
      <div style="margin-bottom:32px;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <span style="width:24px; height:24px; border-radius:50%; background:var(--brand-soft); color:var(--brand); font-size:12px; font-weight:700; display:flex; align-items:center; justify-content:center;">2</span>
          <h2 style="font-size:16px; font-weight:700; margin:0;">Financial Standing</h2>
        </div>
        <p style="font-size:12px; color:var(--muted); margin:0 0 16px 32px;">Income stability, employment tenure, and credit score.</p>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:16px; padding-left:32px;">
          <div class="form-group">
            <label class="form-label" for="Income">Annual Income ($) *</label>
            <input type="number" class="form-input" id="Income" name="Income" min="0" max="10000000" step="1000" value="115000" required>
            <span class="form-hint">Annual gross income in USD</span>
          </div>

          <div class="form-group">
            <label class="form-label" for="EmploymentType">Employment Type *</label>
            <select class="form-select" id="EmploymentType" name="EmploymentType" required>
              <option value="Full-time" selected>Full-time</option>
              <option value="Part-time">Part-time</option>
              <option value="Self-employed">Self-employed</option>
              <option value="Unemployed">Unemployed</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="MonthsEmployed">Months Employed *</label>
            <input type="number" class="form-input" id="MonthsEmployed" name="MonthsEmployed" min="0" max="600" value="64" required>
            <span class="form-hint">Total continuous tenure in months</span>
          </div>

          <div class="form-group">
            <label class="form-label" for="CreditScore">Credit Score (FICO) *</label>
            <input type="number" class="form-input" id="CreditScore" name="CreditScore" min="300" max="850" value="780" required>
            <span class="form-hint">Standard score between 300 and 850</span>
          </div>
        </div>
      </div>

      <!-- SECTION 3: Loan Details -->
      <div style="margin-bottom:32px;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <span style="width:24px; height:24px; border-radius:50%; background:var(--brand-soft); color:var(--brand); font-size:12px; font-weight:700; display:flex; align-items:center; justify-content:center;">3</span>
          <h2 style="font-size:16px; font-weight:700; margin:0;">Requested Loan Terms</h2>
        </div>
        <p style="font-size:12px; color:var(--muted); margin:0 0 16px 32px;">Requested principal, contract purpose, and repayment schedule.</p>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:16px; padding-left:32px;">
          <div class="form-group">
            <label class="form-label" for="LoanAmount">Loan Amount ($) *</label>
            <input type="number" class="form-input" id="LoanAmount" name="LoanAmount" min="100" max="10000000" step="500" value="25000" required>
            <span class="form-hint">Requested borrowing amount</span>
          </div>

          <div class="form-group">
            <label class="form-label" for="LoanPurpose">Loan Purpose *</label>
            <select class="form-select" id="LoanPurpose" name="LoanPurpose" required>
              <option value="Auto">Auto</option>
              <option value="Business">Business</option>
              <option value="Education">Education</option>
              <option value="Home" selected>Home</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="LoanTerm">Loan Term (Months) *</label>
            <input type="number" class="form-input" id="LoanTerm" name="LoanTerm" min="1" max="600" value="36" required>
            <span class="form-hint">Typical terms: 12, 24, 36, 48, 60</span>
          </div>

          <div class="form-group">
            <label class="form-label" for="InterestRate">Interest Rate (%) *</label>
            <input type="number" class="form-input" id="InterestRate" name="InterestRate" min="0" max="100" step="0.1" value="6.8" required>
            <span class="form-hint">Contract annual rate percentage</span>
          </div>
        </div>
      </div>

      <!-- SECTION 4: Credit Risk Modifiers -->
      <div style="margin-bottom:32px;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <span style="width:24px; height:24px; border-radius:50%; background:var(--brand-soft); color:var(--brand); font-size:12px; font-weight:700; display:flex; align-items:center; justify-content:center;">4</span>
          <h2 style="font-size:16px; font-weight:700; margin:0;">Credit Risk Modifiers</h2>
        </div>
        <p style="font-size:12px; color:var(--muted); margin:0 0 16px 32px;">Debt ratios, credit history depth, and collateral status.</p>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:16px; padding-left:32px;">
          <div class="form-group">
            <label class="form-label" for="DTIRatio">Debt-to-Income (DTI Ratio) *</label>
            <input type="number" class="form-input" id="DTIRatio" name="DTIRatio" min="0" max="1" step="0.01" value="0.22" required>
            <span class="form-hint">Monthly debt &divide; gross income (e.g. 0.22)</span>
          </div>

          <div class="form-group">
            <label class="form-label" for="NumCreditLines">Number of Credit Lines *</label>
            <input type="number" class="form-input" id="NumCreditLines" name="NumCreditLines" min="0" max="100" value="3" required>
            <span class="form-hint">Total open trade lines & accounts</span>
          </div>

          <div class="form-group">
            <label class="form-label" for="HasMortgage">Has Existing Mortgage *</label>
            <select class="form-select" id="HasMortgage" name="HasMortgage" required>
              <option value="Yes" selected>Yes</option>
              <option value="No">No</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="HasCoSigner">Has Co-Signer *</label>
            <select class="form-select" id="HasCoSigner" name="HasCoSigner" required>
              <option value="No" selected>No</option>
              <option value="Yes">Yes</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div style="display:flex; justify-content:space-between; align-items:center; padding-top:20px; border-top:1px solid var(--border); flex-wrap:wrap; gap:12px;">
        <button type="button" class="btn btn-secondary" id="resetBtn">
          Reset Form
        </button>

        <button type="button" class="btn btn-primary btn-lg" id="runAssessmentBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
          <span>Run ML Risk Assessment</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Loading State View -->
  <div id="loadingView" style="display:none; text-align:center; padding:60px 20px;">
    <div style="width:50px; height:50px; border:3px solid var(--border); border-top-color:var(--brand); border-radius:50%; animation:spin 0.8s linear infinite; margin:0 auto 16px;"></div>
    <div style="font-size:16px; font-weight:700; color:var(--text); margin-bottom:4px;">Evaluating Machine Learning Risk Pipeline...</div>
    <div style="font-size:13px; color:var(--muted);" id="loadingSubtitle">Applying StandardScaler & Logistic Regression inference...</div>
  </div>

  <!-- Dynamic Prediction Result Target View -->
  <div id="resultView" style="display:none; margin-top:32px;"></div>

</div>

<style>
@keyframes spin { to { transform: rotate(360deg); } }
</style>

<%- include('../partials/footer', { extraScripts: '<script src="/static/js/predict.js"></script>' }) %>
